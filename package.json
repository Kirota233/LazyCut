{
  "name": "lazycut-source",
  "version": "1.8.1",
  "private": true,
  "type": "module",
  "description": "LazyCut 功能源码与开发工具",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
